   "source": [
    "import torch\n",
    "\n",
    "def f(i: float) -> torch.Tensor:\n",
    "    return torch.tensor(i)\n",
    "\n",
    "stack = torch.stack([f(i+0.1) for i in range(5)])\n",
    "\n",
    "stack.mean()\n"
   ]
  }
